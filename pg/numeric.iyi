# PostgreSQL's `numeric`: arbitrary precision, and possibly NaN.
module pg/numeric

import std/int
import std/float
import std/big::{BigDecimal, BigInt, BigRational}
import db/db/value::{CustomValue}

# The Postgres numeric type has arbitrary precision, and can be NaN, "not a
# number".
#
# `#to_f` is an approximate conversion; `#to_big_d` and `#to_big_r` keep
# every digit. crystal-pg had those two in the optional `pg_ext` files
# because Crystal's big numbers need LibGMP; iyi's do not, so they are here.
pub class Numeric < CustomValue
  # :nodoc:
  enum Sign
    Pos =  0x0000
    Neg =  0x4000
    Nan = -0x4000
  end

  # size of digits array
  getter ndigits : Int16

  # location of decimal point in digits array
  # can be negative for small numbers such as 0.0000001
  getter weight : Int16

  # positive, negative, or nan
  getter sign : Sign

  # number of decimal point digits shown
  # 1.10 is and 1.100 would only differ here
  getter dscale : Int16

  # array of numbers from 0-10,000 representing the numeric
  # (not an array of individual digits!)
  getter digits : Array(Int16)

  def initialize(@ndigits : Int16, @weight : Int16, sign : Int16, @dscale : Int16, @digits : Array(Int16))
    @sign = Sign.from_value?(sign.to_i32) || raise "invalid numeric sign: #{sign}"
  end

  # Returns `true` if the numeric is not a number.
  def nan? : Bool
    sign == Sign::Nan
  end

  # Returns `true` if the numeric is negative.
  def neg? : Bool
    sign == Sign::Neg
  end

  def ==(other : Numeric) : Bool
    ndigits == other.ndigits && weight == other.weight && sign == other.sign &&
      dscale == other.dscale && digits == other.digits
  end

  def hash : Int32
    to_s.hash
  end

  # The approximate representation of the numeric as a 64-bit float.
  #
  # Very small and very large values may be inaccurate and precision will be
  # lost; `#to_big_d` and `#to_big_r` keep it. NaN returns NaN.
  def to_f : Float64
    to_f64
  end

  # ditto
  def to_f64 : Float64
    return Float64::NAN if nan?
    # reverse and add the smaller digits first to try and not lose as much precision
    num = 0_f64
    index = 0
    digits.reversed.each do |n|
      num += n.to_f64 * (10_000_f64 ** index)
      index += 1
    end
    den = 10_000_f64 ** (ndigits.to_i32 - 1 - weight.to_i32)
    quot = num / den
    neg? ? -quot : quot
  end

  # A `BigDecimal` with every digit of the numeric; zero for NaN.
  def to_big_d : BigDecimal
    return BigDecimal.new(0, 0) if nan? || ndigits == 0

    num = big_digits
    scale = 4 * (ndigits.to_i32 - 1 - weight.to_i32)
    quot = BigDecimal.new(num, scale)
    neg? ? -quot : quot
  end

  # A `BigRational` with every digit of the numeric; zero for NaN.
  def to_big_r : BigRational
    return BigRational.new(0, 1) if nan? || ndigits == 0

    num = big_digits
    exponent = ndigits.to_i32 - 1 - weight.to_i32
    quot = if exponent >= 0
             BigRational.new(num, BigInt.new(10_000) ** exponent)
           else
             BigRational.new(num * (BigInt.new(10_000) ** -exponent), BigInt.new(1))
           end
    neg? ? -quot : quot
  end

  private def big_digits : BigInt
    ten_k = BigInt.new(10_000)
    digits.reduce(BigInt.new(0)) { |a, i| a * ten_k + BigInt.new(i.to_i32) }
  end

  def inspect : String
    to_s
  end

  def to_log : String
    to_s
  end

  def to_s : String
    String.build do |io|
      write_to(io)
    end
  end

  private def write_to(io : String::Builder) : Nil
    if ndigits == 0
      if nan?
        io << "NaN"
      else
        io << '0'
        if dscale > 0
          io << '.'
          dscale.to_i32.times { io << '0' }
        end
      end
      return
    end

    io << '-' if neg?

    pos = 0
    w = weight.to_i32

    if w >= 0
      io << digits[0].to_s
      pos += 1
      idx = 1
      while idx <= w
        pos += 1
        d = digits[idx]?
        str = d.nil? ? "" : d.to_s
        (4 - str.size).times { io << '0' }
        io << str
        idx += 1
      end
    end

    scale = dscale.to_i32
    return if scale <= 0

    io << '0' if w < 0
    io << '.'

    count = 0
    (-1 - w).times do
      io << "0000"
      count += 4
    end

    n = ndigits.to_i32
    idx = pos
    while idx < n
      str = digits[idx].to_s

      (4 - str.size).times do
        io << '0'
        count += 1
      end

      if idx == n - 1
        remain = (scale + str.size) % 4
        str = str[0, remain] unless remain == 0
      end
      io << str
      count += str.size
      idx += 1
    end

    (scale - count).times { io << '0' }
  end
end
