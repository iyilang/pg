# crystal-pg's spec/pg/connection_spec.cr.
module pg/connection_test

import std/env
import std/time::{Time}
import std/uri::{URI}
import std/socket::{IyiSocket}
import db
import db/db/errors::*
import db/db/spec::{describe, it, expect_error}
import pg/pq/frame::{Notice, Notification}
import pg/pq/errors::{PQError}
import pg/core::{PGConnection}
import pg/pq/stream::{Stream}
import pg
import pg/testing/spec_helper::*

describe "PG::Connection#initialize" do
  it "answers ConnectionRefused on bad connections" do
    expect_error(::Db.open("postgres://localhost:5433"), ConnectionRefused)
    nil
  end

  it "sets the application name" do
    uri = URI.parse(DB_URL)
    uri.query = "application_name=specs"
    with_db_at(uri.to_s) do |db|
      assert db.query_one("SHOW application_name", as: String).or_panic == "specs"
    end
  end
end

def elapsed_ms(since : UInt64) : Int64
  ((Time.monotonic_nanoseconds - since) // 1000000_u64).to_i64
end

# Connects to *url*, which must fail with connect_timeout's error after
# about *bound_ms*.
def assert_times_out(url : String, bound_ms : Int64) : Nil
  started = Time.monotonic_nanoseconds
  result = ::Db.connect(url)
  took = elapsed_ms(started)
  if result.is_a?(ConnectionRefused)
    assert result.message.includes?("timeout expired"), result.message
  else
    assert false, "#{url}: #{result.inspect}"
  end
  assert took >= bound_ms - 100 && took < bound_ms + 2000, "#{url}: #{took} ms"
end

describe "PG::Connection connect_timeout" do
  it "gives up on a server that never answers, after the bound (1 meaning 2 s)" do
    listener = IyiSocket.listen("127.0.0.1", 0)
    defer listener.close
    base = "postgres://postgres:postgres@127.0.0.1:#{listener.local_port}/db"
    # unencrypted: the startup waits for an answer
    env_var_bubble { assert_times_out("#{base}?sslmode=disable&connect_timeout=1", 2000) }
    # prefer: the SSLRequest's answer does, and the bound is PGCONNECT_TIMEOUT's
    env_var_bubble do
      ENV["PGCONNECT_TIMEOUT"] = "1"
      assert_times_out("#{base}?sslmode=prefer", 2000)
    end
  end

  it "bounds a TLS handshake the server never answers" do
    listener = IyiSocket.listen("127.0.0.1", 0)
    defer listener.close
    group do |g|
      g.spawn do
        peer = listener.accept
        if peer.is_a?(IyiSocket)
          peer.read(8) # the SSLRequest
          peer.write("S")
          # silent, whatever the client sends, until it gives up and closes
          while (got = peer.read).is_a?(String) && !got.empty?
          end
          peer.close
        end
        0
      end
      env_var_bubble { assert_times_out("postgres://postgres:postgres@127.0.0.1:#{listener.local_port}/db?sslmode=require&connect_timeout=2", 2000) }
    end
  end

  it "bounds the TCP connect to an address that drops it" do
    started = Time.monotonic_nanoseconds
    result = ::Db.connect("postgres://postgres:postgres@10.255.255.1:5432/db?sslmode=disable&connect_timeout=2")
    took = elapsed_ms(started)
    # a network that says the address is unreachable answers sooner
    assert result.is_a?(ConnectionRefused), result.inspect
    assert took < 4000, "#{took} ms"
  end
end

describe "PG::Connection options" do
  it "starts the session with the options given" do
    uri = URI.parse(DB_URL)
    uri.query = "options=-c%20search_path%3Dfoo%20-c%20statement_timeout%3D5000"
    with_db_at(uri.to_s) do |db|
      assert db.query_one("SHOW search_path", as: String).or_panic == "foo"
      assert db.query_one("SHOW statement_timeout", as: String).or_panic == "5s"
    end
  end

  it "takes them from PGOPTIONS" do
    env_var_bubble do
      ENV["PGOPTIONS"] = "-c search_path=bar"
      with_db_at(DB_URL) do |db|
        assert db.query_one("SHOW search_path", as: String).or_panic == "bar"
      end
    end
  end
end

describe "PG::Connection#backend_pid" do
  it "is the server process's id" do
    with_connection do |conn|
      assert conn.backend_pid != 0
      assert conn.scalar("select pg_backend_pid()").or_panic == conn.backend_pid
    end
  end
end

describe "PG::Connection#cancel" do
  it "cancels the running statement from another task, and the connection goes on" do
    with_connection do |conn|
      outcome = nil.as(DBError?)
      sent = nil.as(DBError?)
      took = 0_i64
      group do |g|
        g.spawn do
          sleep(200)
          sent = conn.cancel
          0
        end
        started = Time.monotonic_nanoseconds
        result = conn.exec("select pg_sleep(30)")
        took = elapsed_ms(started)
        outcome = result if result.is_a?(DBError)
      end
      assert sent.nil?, sent.inspect
      error = outcome
      assert error.is_a?(PQError) && error.field_message(:code) == "57014", error.inspect
      assert took >= 150 && took < 5000, "#{took} ms"
      assert conn.scalar("select 1").or_panic == 1
    end
  end

  it "does nothing when no statement runs" do
    with_connection do |conn|
      conn.cancel.or_panic
      assert conn.scalar("select 1").or_panic == 1
    end
  end
end

describe "PG::Connection#driver_name" do
  it "returns the name the driver is registered with" do
    with_connection do |conn|
      assert conn.driver_name == "postgres"
    end
  end
end

describe "PG::Connection#server_name" do
  it "returns PostgreSQL" do
    with_connection do |conn|
      assert conn.server_name == "PostgreSQL"
    end
  end
end

describe "PG::Connection#server_version" do
  it "returns the version reported by the server" do
    with_connection do |conn|
      assert conn.server_version == conn.scalar("SHOW server_version").or_panic
    end
  end
end

describe "PG::Connection#on_notice" do
  it "sends notices to on_notice" do
    last_notice : Notice? = nil
    PG_DB.using_connection do |conn|
      conn.as(PGConnection).on_notice do |notice|
        last_notice = notice
        nil
      end
      nil
    end.or_panic

    PG_DB.using_connection do |conn|
      conn.as(PGConnection).exec_all(<<-SQL).or_panic
        SET client_min_messages TO notice;
        DO language plpgsql $$
        BEGIN
          RAISE NOTICE 'hello, world!';
        END
        $$;
      SQL
      nil
    end.or_panic

    if notice = last_notice
      assert notice.to_s == "NOTICE:  hello, world!\n", notice.to_s
    else
      raise "no notice"
    end
  end
end

describe "PG::Connection#on_notification" do
  it "does listen/notify within same connection" do
    last_note : Notification? = nil
    with_db do |db|
      db.using_connection do |conn|
        conn.as(PGConnection).on_notification { |note| last_note = note; nil }
        conn.exec("listen somechannel").or_panic
        conn.exec("notify somechannel, 'do a thing'").or_panic
        nil
      end.or_panic
    end

    if note = last_note
      assert note.channel == "somechannel"
      assert note.payload == "do a thing"
    else
      raise "no notification"
    end
  end
end

describe "PG#listen" do
  it "opens a special listen only connection" do
    got = false
    ch = Channel(Nil).new
    group do |g|
      conn = ::Pg.connect_listen(DB_URL, ["foo", "bar"], g) do |_|
        got = true
        ch.send(nil)
        nil
      end.or_panic
      defer conn.close

      assert got == false

      PG_DB.exec("notify wrong, 'hello'").or_panic
      assert got == false

      PG_DB.exec("notify foo, 'hello'").or_panic
      ch.receive
      assert got == true
      got = false

      PG_DB.exec("notify bar, 'hello'").or_panic
      ch.receive
      assert got == true
    end
  end
end

describe "PG#read_next_row_start" do
  it "handles reading a notice" do
    with_connection do |db|
      db.exec("SET client_min_messages TO notice").or_panic
      db.exec(<<-SQL).or_panic
        CREATE OR REPLACE FUNCTION foo() RETURNS integer AS $$
        BEGIN
          RAISE NOTICE 'foo';
          RAISE NOTICE 'bar';
          RETURN 42;
        END;
        $$ LANGUAGE plpgsql;
        SQL

      received_notices = [] of String
      db.on_notice do |notice|
        received_notices << notice.message
        nil
      end
      assert db.scalar("SELECT foo()").or_panic == 42
      assert received_notices == ["foo", "bar"], received_notices.to_s

      db.exec("DROP FUNCTION foo()").or_panic
    end
  end
end

# crystal-pg reads `now()` into a `Time` in the session's `TimeZone`. iyi's
# `Time` is UTC-only, so this checks instead that the server parameter
# follows `SET TIME ZONE` and that `now()` is the same instant whatever the
# session's zone.
describe "PG#time_zone" do
  it "reads the same instant under any session time zone" do
    with_connection do |db|
      db.exec("SET TIME ZONE 'America/Los_Angeles'").or_panic
      assert db.connection.server_parameters["TimeZone"]? == "America/Los_Angeles"

      db.transaction do |_|
        la = db.query_one("SELECT now()", as: Time).or_panic
        db.exec("SET LOCAL TIME ZONE 'America/New_York'").or_panic
        assert db.connection.server_parameters["TimeZone"]? == "America/New_York"
        ny = db.query_one("SELECT now()", as: Time).or_panic
        db.exec("SET LOCAL TIME ZONE 'UTC'").or_panic
        utc = db.query_one("SELECT now()", as: Time).or_panic
        assert la == utc, "#{la} != #{utc}"
        assert ny == utc, "#{ny} != #{utc}"
        nil
      end.or_panic

      assert db.connection.server_parameters["TimeZone"]? == "America/Los_Angeles"
    end
  end
end

# crystal-pg's "#clear_time_zone_cache" is omitted: with UTC-only `Time`
# there is no time zone cache to clear.

describe "PG COPY" do
  it "properly handles partial reads and consumes data on early close" do
    with_connection do |db|
      io = db.exec_copy("COPY (VALUES (1), (333)) TO STDOUT").or_panic
      assert io.read_char == '1'
      assert io.read_char == '\n'
      assert io.read_char == '3'
      assert io.read_char == '3'
      io.close.or_panic
      assert db.scalar("select 1").or_panic == 1
    end
  end

  # crystal-pg wrote this one as `if "..."`, which always ran its body.
  it "survives a COPY FROM STDIN and COPY TO STDOUT round-trip" do
    with_connection do |db|
      data = "123\tdata\n\\N\t\\N\n"
      db.exec("CREATE TEMPORARY TABLE IF NOT EXISTS copy_test (a int, b text)").or_panic

      wr = db.exec_copy("COPY copy_test FROM STDIN").or_panic
      (wr << data).or_panic
      wr.close.or_panic

      rd = db.exec_copy("COPY copy_test TO STDOUT").or_panic
      read = rd.gets_to_end.or_panic
      assert read == data, read.inspect

      db.exec("DROP TABLE copy_test").or_panic
    end
  end

  it "streams a COPY FROM STDIN instead of collecting it" do
    with_connection do |db|
      db.exec("CREATE TEMPORARY TABLE copy_big (b text)").or_panic
      line = "#{"x" * 9999}\n"
      stream = db.connection.stream
      wr = db.exec_copy("COPY copy_big FROM STDIN").or_panic
      most = 0
      500.times do
        (wr << line).or_panic
        most = stream.pending if stream.pending > most
      end
      wr.close.or_panic
      # 5 MB went out; at most a buffer's worth and one line waited at once
      assert most < Stream::BUFFER_SIZE + line.bytesize, most.to_s
      assert db.scalar("select count(*) from copy_big where length(b) = 9999").or_panic == 500_i64
      db.exec("DROP TABLE copy_big").or_panic
    end
  end
end

def with_db_at(url : String, & : ::Db::Core::Database -> Nil) : Nil
  ::Db.open(url) { |db| yield db }.or_panic
end
