# A bound argument as the `Bind` message carries it: bytes, their size (-1
# for NULL), and the format, 0 for text and 1 for binary.
module pg/pq/param

import std/int
import std/float
import std/text
import std/time::{Time, Span}
import std/slice::{Slice, Bytes}
import db/db/value::{DBValue, CustomValue}
import pg/geo::{Point, Line, Circle, LineSegment, Box, Path, Polygon}
import pg/interval::{Interval}
import pg/record::{Record}

pub struct Param
  HEX = "0123456789abcdef"

  getter slice : Bytes
  getter size : Int32
  getter format : Int16
  # The string *slice* points into, held so it lives as long as the param.
  @text : String?

  def initialize(@slice : Bytes, @size : Int32, @format : Int16, @text : String? = nil)
  end

  #  Internal wrapper to represent an encoded parameter
  def self.encode(val : DBValue) : Param
    case val
    when Nil
      binary(Bytes.empty, -1)
    when Bytes
      binary(val, val.size)
    else
      text(text_form(val))
    end
  end

  # *value* in the text form the server reads for its type: what a text
  # parameter carries, and what an array element or a composite field holds
  # before it is quoted.
  def self.text_form(value : DBValue) : String
    case value
    when Nil
      ""
    when Bytes
      String.build(2 + 2 * value.size) do |io|
        io << "\\x"
        write_hex(io, value)
      end
    when Array
      encode_array(value)
    when Time
      # Microseconds, PostgreSQL's precision, cut rather than rounded: the
      # server would round 23:59:59.999999999 into the next day.
      value.to_rfc3339(6)
    when Record
      encode_record(value)
    when Point
      "(#{value.x},#{value.y})"
    when Line
      "{#{value.a},#{value.b},#{value.c}}"
    when Circle
      "<(#{value.x},#{value.y}),#{value.radius}>"
    when LineSegment
      "((#{value.x1},#{value.y1}),(#{value.x2},#{value.y2}))"
    when Box
      "((#{value.x1},#{value.y1}),(#{value.x2},#{value.y2}))"
    when Path
      value.closed? ? encode_points("(", value.points, ")") : encode_points("[", value.points, "]")
    when Polygon
      encode_points("(", value.points, ")")
    when Interval
      # https://www.postgresql.org/docs/current/datatype-datetime.html#DATATYPE-INTERVAL-INPUT
      "#{value.months} months #{value.days} days #{value.microseconds} microseconds"
    when Span
      "#{value.total_seconds_i64} seconds #{value.nanoseconds // 1000} microseconds"
    else
      value.to_s
    end
  end

  private def self.encode_points(left : String, points : Array(Point), right : String) : String
    String.build do |io|
      io << left
      points.each_with_index do |point, i|
        io << "," if i > 0
        io << "(" << point.x << "," << point.y << ")"
      end
      io << right
    end
  end

  # The composite literal of *record*: `(1,"a b",)`, a NULL field empty and
  # every other one quoted, so commas, parentheses, quotes, backslashes,
  # spaces and empty strings come through as they are.
  def self.encode_record(record : Record) : String
    String.build do |io|
      io << '('
      record.data.each_with_index do |field, index|
        io << ',' if index > 0
        encode_string(io, text_form(field)) unless field.nil?
      end
      io << ')'
    end
  end

  def self.binary(slice : Bytes, size : Int32) : Param
    new(slice, size, 1_i16)
  end

  def self.text(string : String) : Param
    new(Bytes.new(string.to_unsafe, string.bytesize, read_only: true), string.bytesize, 0_i16, string)
  end

  # The array literal of *array*: `{1,2,3}`, `{"a","b"}`, `{NULL}`.
  def self.encode_array(array : Array(DBValue)) : String
    String.build(array.size + 2) do |io|
      encode_array(io, array)
    end
  end

  def self.encode_array(io : String::Builder, value : DBValue) : Nil
    case value
    when Array
      io << "{"
      value.each_with_index do |item, index|
        io << "," if index > 0
        encode_array(io, item)
      end
      io << "}"
    when Nil
      io << "NULL"
    when Bool
      io << (value ? 't' : 'f')
    when Bytes
      io << %{"\\\\x}
      write_hex(io, value)
      io << '"'
    when String
      encode_string(io, value)
    when Time, CustomValue
      encode_string(io, text_form(value))
    else
      io << value.to_s
    end
  end

  private def self.write_hex(io : String::Builder, bytes : Bytes) : Nil
    digits = HEX.to_unsafe
    bytes.each do |byte|
      io << digits[byte >> 4].unsafe_chr << digits[byte & 0x0F].unsafe_chr
    end
  end

  # A double-quoted array element or composite field, `"` and `\` escaped
  # by a backslash.
  private def self.encode_string(io : String::Builder, value : String) : Nil
    io << '"'
    value.each_char do |char|
      io << '\\' if char == '"' || char == '\\'
      io << char
    end
    io << '"'
  end
end
