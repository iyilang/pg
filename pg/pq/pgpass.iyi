# The password file: `~/.pgpass` (`%APPDATA%\postgresql\pgpass.conf` on
# Windows), or the file `PGPASSFILE` names.
#
# https://www.postgresql.org/docs/current/libpq-pgpass.html
module pg/pq/pgpass

import std/env
import std/file
import std/path::{Path}
import std/text
import std/log::{Log, Logger, Severity}
import std/mutex::{Mutex}

# A std `Logger` behind a lock, so a task on any worker may log through it:
# std's `Logger` is not `Share` - `level=`, `backend=` and `for` change it
# in place - and a connection logs from whichever worker its task runs on.
# The message is built only when the logger takes its severity, as the
# `Logger`'s block forms build it.
#
# The logger itself is `Log.for(source)`'s, which a program configures as
# any std logger: `Log.for("pg").level = Severity::Debug`, at startup.
pub class SharedLog
  @logger : Mutex(Logger)

  def initialize(source : String)
    @logger = Mutex.new { Log.for(source) }
  end

  def debug(& : -> String) : Nil
    write(Severity::Debug) { yield }
  end

  def warn(& : -> String) : Nil
    write(Severity::Warn) { yield }
  end

  def error(& : -> String) : Nil
    write(Severity::Error) { yield }
  end

  # A task cancelled while it waits for the lock writes nothing.
  private def write(severity : Severity, & : -> String) : Nil
    wanted = @logger.get { |log| severity >= log.level && severity != Severity::None }
    return unless wanted == true
    message = yield
    @logger.lock { |log| log.log(severity, message) }
    nil
  end
end

# The logger for this library, crystal-pg's `PQ::Log`; its source is "pg".
pub LOG = SharedLog.new("pg")

pub class PgPass
  # The password the file holds for *host*, *port*, *db* and *user*, or nil.
  def self.locate(host : String, port : Int32, db : String, user : String) : String?
    filename = ENV["PGPASSFILE"]? || default_file
    return nil if filename.nil?

    unless File.exists?(filename) && File.file?(filename)
      LOG.debug { "No pgpass file available" }
      return nil
    end
    unless File.readable?(filename)
      LOG.warn { "Cannot read pgpass file #{filename}" }
      return nil
    end

    {% unless flag?(:win32) %}
      unless (File.info(filename).permissions.to_i & 0o7177) == 0
        LOG.warn { "Cannot use pgpass file - permissions are inappropriate must be 0600 or less" }
      end
    {% end %}

    File.read_lines(filename).each do |line|
      next if line.starts_with?("#")

      fields = line.split(':')

      unless fields.size == 5
        LOG.warn { "PGPass file does not appear to be properly formatted - errors may occur" }
        next
      end

      next unless fields[0] == "*" || host == fields[0]
      next unless fields[1] == "*" || port == fields[1].to_i?
      next unless fields[2] == "*" || db == fields[2]
      next unless fields[3] == "*" || user == fields[3]

      return fields[4]
    end
    nil
  end

  # libpq's: `~/.pgpass`, or `%APPDATA%\postgresql\pgpass.conf` on Windows.
  def self.default_file : String?
    {% if flag?(:win32) %}
      if appdata = ENV["APPDATA"]?
        File.join(appdata, "postgresql", "pgpass.conf")
      end
    {% else %}
      Path["~/.pgpass"].expand(home: true).to_s
    {% end %}
  end
end
