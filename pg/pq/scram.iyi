# The password exchanges: SCRAM-SHA-256 (RFC 5802, RFC 7677) and the md5
# challenge. crystal-pg took HMAC and PBKDF2 from OpenSSL; here they are
# written over `std/digest`'s SHA-256.
#
# SCRAM-SHA-256-PLUS binds the exchange to the TLS channel under it
# (`tls-server-end-point`, RFC 5929, the binding PostgreSQL takes): a man
# in the middle who ended TLS on both sides cannot relay it.
module pg/pq/scram

import std/int
import std/digest::{SHA256, MD5}
import std/base64::{Base64}
import std/random::{Random}
import std/text
import pg/pq/errors::{ConnectionError}

# The bytes of *data* as a string, which the digests take.
pub def bytes_string(data : Array(UInt8)) : String
  String.new(data.size) do |buffer|
    data.each_with_index { |byte, index| buffer[index] = byte }
  end
end

# HMAC-SHA-256 of *message* under *key* (RFC 2104).
pub def hmac_sha256(key : String, message : String) : String
  block = key.bytesize > 64 ? bytes_string(SHA256.hash_bytes(key)) : key
  kbytes = block.bytes
  ipad = String.new(64) do |buffer|
    64.times { |i| buffer[i] = (i < kbytes.size ? kbytes[i] : 0_u8) ^ 0x36_u8 }
  end
  opad = String.new(64) do |buffer|
    64.times { |i| buffer[i] = (i < kbytes.size ? kbytes[i] : 0_u8) ^ 0x5c_u8 }
  end
  inner = bytes_string(SHA256.hash_bytes(ipad + message))
  bytes_string(SHA256.hash_bytes(opad + inner))
end

# PBKDF2 with HMAC-SHA-256, one 32-byte block: SCRAM's `Hi()`.
pub def pbkdf2_sha256(password : String, salt : String, iterations : Int32) : String
  first = String.new(4) do |buffer|
    buffer[0] = 0_u8
    buffer[1] = 0_u8
    buffer[2] = 0_u8
    buffer[3] = 1_u8
  end
  u = hmac_sha256(password, salt + first)
  result = u.bytes
  (iterations - 1).times do
    u = hmac_sha256(password, u)
    ubytes = u.bytes
    32.times { |i| result[i] = result[i] ^ ubytes[i] }
  end
  bytes_string(result)
end

# The answer to an md5 challenge: `md5` and the hex digest of the hex
# digest of password and user, salted.
pub def md5_password(user : String, password : String, salt : String) : String
  inner = MD5.hexdigest(password + user)
  "md5" + MD5.hexdigest(inner + salt)
end

# One SCRAM-SHA-256 exchange, from the client's first message to the check
# of the server's signature.
pub class SaslContext
  SCRAM_NAME      = "SCRAM-SHA-256"
  SCRAM_PLUS_NAME = "SCRAM-SHA-256-PLUS"

  getter name : String
  getter client_first_msg : String
  @client_nonce : String
  @server_sig : String?
  # The GS2 header (RFC 5802 section 7): `p=tls-server-end-point` when the
  # exchange is bound, `y` when the client could bind it and the server
  # offered no way to, `n` when the client cannot.
  @gs2_header : String
  @binding : Array(UInt8)

  # An exchange bound to *binding*, the server's `tls-server-end-point`
  # data, when there is one (SCRAM-SHA-256-PLUS); unbound otherwise,
  # *binding_possible* saying whether it could have been.
  def initialize(@password : String, nonce : String? = nil, binding : Array(UInt8)? = nil, binding_possible : Bool = false)
    @client_nonce = nonce || SaslContext.nonce
    if binding
      @name = SCRAM_PLUS_NAME
      @gs2_header = "p=tls-server-end-point,,"
      @binding = binding
    else
      @name = SCRAM_NAME
      @gs2_header = binding_possible ? "y,," : "n,,"
      @binding = [] of UInt8
    end
    @client_first_msg = "#{@gs2_header}n=,r=#{@client_nonce}"
    @server_sig = nil
  end

  # Eighteen bytes of the platform's entropy (`Random::Secure`), URL-safe
  # base64, as crystal-pg sends: RFC 5802 asks that no one can guess it.
  def self.nonce : String
    Random::Secure.urlsafe_base64(18)
  end

  # The client-final-message for the server-first-message *body*.
  def generate_client_final_message(server_first_msg : String) : String | ConnectionError
    params = server_first_msg.split(',')
    r = attribute(params, 'r')
    s = attribute(params, 's')
    i = attribute(params, 'i')
    if r.nil? || s.nil? || i.nil?
      return ConnectionError.new("SASL: malformed server-first-message")
    end
    iterations = i.to_i?
    return ConnectionError.new("SASL: malformed iteration count") if iterations.nil? || iterations < 1
    unless r.starts_with?(@client_nonce)
      return ConnectionError.new("SASL: scram server nonce does not start with client nonce")
    end

    # the GS2 header and the channel binding data: biws, base64 of "n,,",
    # when there is no binding
    channel = Base64.encode(@gs2_header + bytes_string(@binding))
    client_final_msg_without_proof = "c=#{channel},r=#{r}"
    salted_pass = pbkdf2_sha256(@password, Base64.decode(s), iterations)
    server_key = hmac_sha256(salted_pass, "Server Key")
    client_key = hmac_sha256(salted_pass, "Client Key")
    auth_msg = "n=,r=#{@client_nonce},#{server_first_msg},#{client_final_msg_without_proof}"
    stored_key = bytes_string(SHA256.hash_bytes(client_key))
    client_sig = hmac_sha256(stored_key, auth_msg)
    @server_sig = hmac_sha256(server_key, auth_msg)
    kb = client_key.bytes
    sb = client_sig.bytes
    proof = String.new(32) do |buffer|
      32.times { |index| buffer[index] = kb[index] ^ sb[index] }
    end
    "#{client_final_msg_without_proof},p=#{Base64.encode(proof)}"
  end

  # Checks the server-final-message *server_message* (`v=...`).
  def verify_server_signature(server_message : String) : Nil | ConnectionError
    expected = @server_sig
    return ConnectionError.new("SASL: no client-final-message was sent") if expected.nil?
    unless server_message.starts_with?("v=") && server_message[2..-1] == Base64.encode(expected)
      return ConnectionError.new("server signature does not match")
    end
    nil
  end

  private def attribute(params : Array(String), key : Char) : String?
    found = params.find { |p| p.bytesize >= 2 && p[0] == key && p[1] == '=' }
    found.nil? ? nil : found[2..-1]
  end
end
