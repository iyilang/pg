# Where and as whom to connect: a `postgres://` URL, a libpq `key=value`
# string, or the parts, each defaulted from the `PG*` environment variables
# as libpq defaults them.
module pg/pq/conninfo

import std/env
import std/file
import std/path::{Path}
import std/text
import std/uri::{URI, Params}
import std/user::{User}
import db/db/errors::{DBError, ArgumentError}
import pg/pq/pgpass::{PgPass, LOG}

pub struct ConnInfo
  SOCKET_SEARCH = ["/run/postgresql", "/tmp", "/var/run/postgresql"]

  SUPPORTED_AUTH_METHODS = ["cleartext", "md5", "scram-sha-256", "scram-sha-256-plus"]

  SSL_MODES = [:disable, :allow, :prefer, :require, :"verify-ca", :"verify-full"]

  # The keys a URI's query or a `key=value` string may hold besides the TLS
  # and authentication ones `handle_sslparam` reads: the connection's own,
  # and iyi-db's pool options. Any other is reported, not silently dropped.
  KNOWN_KEYS = [
    "host", "port", "dbname", "user", "password", "application_name", "replication",
    "initial_pool_size", "max_pool_size", "max_idle_pool_size", "checkout_timeout",
    "retry_attempts", "retry_delay", "prepared_statements", "prepared_statements_cache",
  ]

  # The `ssl_min_protocol_version`s std/tls speaks.
  TLS_VERSIONS = ["TLSv1.2", "TLSv1.3"]

  # The host. If it starts with a / it is the directory of a local Unix
  # socket.
  getter host : String

  # The port, defaults to 5432. Also names a Unix socket's file.
  getter port : Int32

  # The database name.
  getter database : String

  # The user.
  getter user : String

  # The password. Optional.
  getter password : String?

  # The sslmode: `:prefer` unless given.
  getter sslmode : Symbol

  # The sslcert. Optional.
  getter sslcert : String?

  # The sslkey. Optional.
  getter sslkey : String?

  # The sslrootcert: a PEM file of the roots a server's certificate must
  # chain to, or `"system"` for the system's. Optional.
  getter sslrootcert : String?

  # Whether SCRAM binds itself to the TLS channel (SCRAM-SHA-256-PLUS):
  # `:prefer` (when it can), `:require` or `:disable`.
  getter channel_binding : Symbol

  # The oldest TLS version spoken: `"TLSv1.2"` unless given, or
  # `"TLSv1.3"`.
  getter ssl_min_protocol_version : String

  # The application name. Optional (defaults to "crystal").
  getter application_name : String

  # `"database"` (or `"true"`) for a replication connection.
  getter replication : String?

  # The authentication methods the server may ask for.
  getter auth_methods : Array(String)

  # A connection description from its parts; what is not given is taken from
  # the environment (`PGHOST`, `PGPORT`, `PGDATABASE`, `PGUSER`,
  # `PGPASSWORD`, `PGAPPNAME`) or the password file. The database defaults
  # to the user's name, as libpq's does. An `sslmode` not in `SSL_MODES` is
  # a mistake in the program, and panics.
  def initialize(host : String? = nil, database : String? = nil, user : String? = nil, password : String? = nil, port : Int32? = nil, sslmode : Symbol = :prefer, application_name : String? = nil, @replication : String? = nil)
    raise "unknown sslmode #{sslmode}: #{SSL_MODES.join(", ")}" unless SSL_MODES.includes?(sslmode)
    @port = port || ((ENV["PGPORT"]? || "").to_i? || 5432)
    @host = ConnInfo.default_host(host, @port)
    @user = user || ENV["PGUSER"]? || ConnInfo.current_user_name
    @database = ConnInfo.default_database(database, @user).lchop('/')
    @sslmode = sslmode
    @password = password || ENV["PGPASSWORD"]? || PgPass.locate(@host, @port, @database, @user)
    @application_name = application_name || ENV["PGAPPNAME"]? || "crystal"
    @auth_methods = ["scram-sha-256-plus", "scram-sha-256", "md5"]
    @sslcert = nil
    @sslkey = nil
    @sslrootcert = nil
    @channel_binding = :prefer
    @ssl_min_protocol_version = "TLSv1.2"
  end

  # Whether `host` names the directory of a Unix socket.
  def unix_socket? : Bool
    Path.new(@host).absolute? && @host.starts_with?('/')
  end

  # From either a `postgres://` (or `postgresql://`) URL or a libpq
  # `key=value` string.
  def self.from_conninfo_string(conninfo : String) : ConnInfo | DBError
    if conninfo.starts_with?("postgres://") || conninfo.starts_with?("postgresql://")
      uri = URI.parse?(conninfo)
      return ArgumentError.new("invalid connection URI: #{conninfo}") if uri.nil?
      from_uri(uri)
    else
      return from_hash({} of String => String) if conninfo == ""

      args = {} of String => String
      conninfo.split(' ').each do |pair|
        next if pair.empty?
        k, eq, v = pair.partition('=')
        return ArgumentError.new("invalid paramater: #{pair}") if eq.empty?
        args[k] = v
      end
      from_hash(args)
    end
  end

  # From a `URI`: its host (or the `host` parameter), port, path as the
  # database, user and password, and `application_name`, `replication`,
  # `sslmode`, `sslcert`, `sslkey`, `sslrootcert`, `channel_binding`,
  # `ssl_min_protocol_version` and `auth_methods` from its query.
  def self.from_uri(uri : URI) : ConnInfo | DBError
    params = Params.parse(uri.query || "")
    hostname = (uri.hostname || "").presence || params["host"]? || ""
    port = uri.port || parse_port(params["port"]?)! || env_port!
    info = ConnInfo.new(hostname.presence, uri.path, uri.user, uri.password, port, :prefer, params["application_name"]?, params["replication"]?)
    params.each do |key, value|
      handled = info.handle_sslparam(key, value)
      return handled if handled.is_a?(DBError)
    end
    info.default_sslmode(params["sslmode"]?)
    info
  end

  # From libpq "conninfo" keys: `"host"`, `"dbname"`, `"user"`,
  # `"password"`, `"port"`, `"sslmode"`, `"sslcert"`, `"sslkey"`,
  # `"sslrootcert"`, `"channel_binding"`, `"ssl_min_protocol_version"`,
  # `"application_name"`, `"replication"` and `"auth_methods"`.
  def self.from_hash(params : Hash(String, String)) : ConnInfo | DBError
    port = parse_port(params["port"]?)! || env_port!
    info = ConnInfo.new(params["host"]?, params["dbname"]?, params["user"]?,
      params["password"]?, port, :prefer, params["application_name"]?, params["replication"]?)
    params.each do |key, value|
      handled = info.handle_sslparam(key, value)
      return handled if handled.is_a?(DBError)
    end
    info.default_sslmode(params["sslmode"]?)
    info
  end

  # The sslmode *mode* names, or `ArgumentError`.
  def self.parse_sslmode(mode : String?) : Symbol | DBError
    case mode
    when nil, "prefer" then :prefer
    when "disable"     then :disable
    when "allow"       then :allow
    when "require"     then :require
    when "verify-ca"   then :"verify-ca"
    when "verify-full" then :"verify-full"
    else
      ArgumentError.new("sslmode #{mode} not supported")
    end
  end

  # The channel_binding *value* names, or `ArgumentError`.
  def self.parse_channel_binding(value : String) : Symbol | DBError
    case value
    when "prefer"  then :prefer
    when "disable" then :disable
    when "require" then :require
    else
      ArgumentError.new("channel_binding #{value} not supported")
    end
  end

  # `sslrootcert=system` without an `sslmode` means `verify-full`, as libpq
  # has it: the system's roots are trusted for the host's name alone.
  protected def default_sslmode(given : String?) : Nil
    @sslmode = :"verify-full" if given.nil? && @sslrootcert == "system"
  end

  protected def self.parse_port(port : String?) : Int32? | DBError
    return nil if port.nil? || port.empty?
    port.to_i? || ArgumentError.new("invalid port: #{port}")
  end

  # `PGPORT`'s port, nil when it is unset, and an error when it is not a
  # number rather than the default port in its place.
  protected def self.env_port : Int32? | DBError
    value = ENV["PGPORT"]?
    return nil if value.nil? || value.empty?
    value.to_i? || ArgumentError.new("invalid PGPORT: #{value}")
  end

  protected def handle_sslparam(key : String, value : String) : Nil | DBError
    case key
    when "sslmode"
      @sslmode = ConnInfo.parse_sslmode(value)!
    when "sslcert"
      @sslcert = value
    when "sslkey"
      @sslkey = value
    when "sslrootcert"
      @sslrootcert = value
    when "channel_binding"
      @channel_binding = ConnInfo.parse_channel_binding(value)!
    when "ssl_min_protocol_version"
      unless TLS_VERSIONS.includes?(value)
        return ArgumentError.new("ssl_min_protocol_version #{value} not supported: TLSv1.2 and TLSv1.3 are")
      end
      @ssl_min_protocol_version = value
    when "auth_methods"
      methods = [] of String
      value.split(',').each do |method|
        name = method.downcase
        next if name.empty? || methods.includes?(name)
        return ArgumentError.new("invalid auth_method #{name}") unless SUPPORTED_AUTH_METHODS.includes?(name)
        methods << name
      end
      @auth_methods = methods
    else
      LOG.warn { "Ignoring the connection parameter #{key}, which this driver does not support" } unless KNOWN_KEYS.includes?(key)
    end
    nil
  end

  protected def self.default_host(h : String?, port : Int32) : String
    socket_name = ".s.PGSQL.#{port}"

    if host = (h || "").presence || ENV["PGHOST"]?
      # For backwards compatibility: a path to the socket file itself means
      # the directory that holds it.
      path = Path.new(host)
      return path.basename == socket_name ? path.parent.to_s : host
    end

    {% unless flag?(:win32) %}
      SOCKET_SEARCH.each do |dir|
        return dir if File.exists?(File.join(dir, socket_name))
      end
    {% end %}
    "localhost"
  end

  protected def self.default_database(db : String?, user : String) : String
    if db && db != "/" && !db.empty?
      db
    else
      ENV["PGDATABASE"]? || user
    end
  end

  # The name of the account the program runs as, the default user, as libpq
  # looks it up by the real user id; "postgres" when the system has no
  # account for it and `$USER` names none. `User.current` panics then, and a
  # panic is caught only at a task's edge, so the lookup runs as a task.
  def self.current_user_name : String
    name = "postgres"
    group do |g|
      task = g.spawn { User.current.name }
      found = task.value
      name = found if found.is_a?(String) && !found.empty?
    end
    name
  end
end
