# crystal-pg's spec/pq/conninfo_spec.cr.
module pg/pq/conninfo_test

import std/env
import std/log::{Log, MemoryBackend, Severity}
import db/db/errors::*
import db/db/spec::{describe, it, expect_error}
import pg/pq/conninfo::{ConnInfo}
import pg/testing/spec_helper::{env_var_bubble}

def assert_default_params(ci : ConnInfo) : Nil
  assert (["/run/postgresql", "/tmp", "/var/run/postgresql"] + ["localhost"]).includes?(ci.host), "host #{ci.host}"
  assert ci.database == ci.user, "database #{ci.database} user #{ci.user}"
  assert ci.password.nil?, "password #{ci.password}"
  assert ci.port == 5432
  assert ci.sslmode == :prefer
  assert ci.application_name == "crystal"
end

def assert_custom_params(ci : ConnInfo) : Nil
  assert ci.host == "host"
  assert ci.database == "db"
  assert ci.user == "user"
  assert ci.password == "pass"
  assert ci.port == 5555
  assert ci.sslmode == :require
  assert ci.application_name == "specs"
end

def assert_ssl_params(ci : ConnInfo) : Nil
  assert ci.sslmode == :"verify-full"
  assert ci.sslcert == "postgresql.crt"
  assert ci.sslkey == "postgresql.key"
  assert ci.sslrootcert == "root.crt"
end

def parse(s : String) : ConnInfo
  ConnInfo.from_conninfo_string(s).or_panic
end

describe "PQ::ConnInfo parts" do
  it "can have all defaults" do
    env_var_bubble do
      assert_default_params ConnInfo.new
    end
  end

  it "can take settings" do
    assert_custom_params ConnInfo.new("host", "db", "user", "pass", 5555, :require, "specs")
  end
end

describe "PQ::ConnInfo.from_conninfo_string" do
  it "parses short postgres urls" do
    env_var_bubble do
      assert_default_params parse("postgres:///")
    end
  end

  it "parses postgres urls" do
    assert_custom_params parse("postgres://user:pass@host:5555/db?sslmode=require&otherparam=ignore&application_name=specs")
    assert_ssl_params parse("postgres://user:pass@host:5555/db?sslmode=verify-full&sslcert=postgresql.crt&sslkey=postgresql.key&sslrootcert=root.crt")
    assert_custom_params parse("postgresql://user:pass@host:5555/db?sslmode=require&application_name=specs")
  end

  it "parses postgres host from socket query string host" do
    assert parse("postgresql://user:pass@/db?host=/sql/socket").host == "/sql/socket"
  end

  it "parses libpq style strings" do
    assert_custom_params parse("host=host dbname=db user=user password=pass port=5555 sslmode=require application_name=specs")
    assert_ssl_params parse("host=host dbname=db user=user password=pass port=5555 sslmode=verify-full sslcert=postgresql.crt sslkey=postgresql.key sslrootcert=root.crt")
    assert parse("host=host").host == "host"
    env_var_bubble do
      assert_default_params parse("")
    end
    expect_error(ConnInfo.from_conninfo_string("hosthost"), ArgumentError)
    nil
  end

  it "parses an IPv6 host" do
    assert parse("postgres://user:pass@[::1]:5555/db").host == "::1"
  end

  it "auth_methods" do
    assert parse("postgres://user:pass@localhost/foo").auth_methods == ["scram-sha-256-plus", "scram-sha-256", "md5"]
    assert parse("postgres://user:pass@localhost/foo?auth_methods=md5").auth_methods == ["md5"]
    assert parse("postgres://user:pass@localhost/foo?auth_methods=").auth_methods == [] of String
    assert parse("postgres://user:pass@localhost/foo?auth_methods=cleartext,md5,scram-sha-256").auth_methods == ["cleartext", "md5", "scram-sha-256"]
    expect_error(ConnInfo.from_conninfo_string("postgres://user:pass@localhost/foo?auth_methods=unsupported"), DBError)
    expect_error(ConnInfo.from_conninfo_string("postgres://user:pass@localhost/foo?auth_methods=md5,unsupported"), DBError)
    nil
  end

  it "TLS parameters" do
    ci = parse("postgres://user:pass@localhost/foo")
    assert ci.channel_binding == :prefer
    assert ci.ssl_min_protocol_version == "TLSv1.2"
    ci = parse("postgres://user:pass@localhost/foo?channel_binding=require&ssl_min_protocol_version=TLSv1.3")
    assert ci.channel_binding == :require
    assert ci.ssl_min_protocol_version == "TLSv1.3"
    assert parse("host=localhost channel_binding=disable").channel_binding == :disable
    expect_error(ConnInfo.from_conninfo_string("postgres://localhost/foo?channel_binding=always"), ArgumentError)
    expect_error(ConnInfo.from_conninfo_string("postgres://localhost/foo?ssl_min_protocol_version=TLSv1.1"), ArgumentError)
    nil
  end

  it "takes sslrootcert=system to mean verify-full unless an sslmode is given" do
    assert parse("postgres://localhost/foo?sslrootcert=system").sslmode == :"verify-full"
    assert parse("host=localhost sslrootcert=system").sslmode == :"verify-full"
    assert parse("postgres://localhost/foo?sslrootcert=system&sslmode=prefer").sslmode == :prefer
    assert parse("postgres://localhost/foo?sslrootcert=root.crt").sslmode == :prefer
  end

  it "uses environment variables" do
    env_var_bubble do
      ENV["PGDATABASE"] = "A"
      ENV["PGHOST"] = "B"
      ENV["PGPASSWORD"] = "C"
      ENV["PGPORT"] = "1"
      ENV["PGUSER"] = "D"
      ENV["PGAPPNAME"] = "S"
      ci = parse("postgres://")
      assert ci.database == "A"
      assert ci.host == "B"
      assert ci.password == "C"
      assert ci.port == 1
      assert ci.user == "D"
      assert ci.application_name == "S"
    end

    env_var_bubble do
      ENV["PGHOST"] = "/path"
      assert parse("postgres://").host == "/path"
    end
  end

  it "refuses a PGPORT that is not a number rather than using 5432" do
    env_var_bubble do
      ENV["PGPORT"] = "54x2"
      expect_error(ConnInfo.from_conninfo_string("postgres://host/db"), ArgumentError)
      expect_error(ConnInfo.from_conninfo_string("host=host"), ArgumentError)
      assert parse("postgres://host:5433/db").port == 5433
    end
  end

  it "defaults the database to the user, PGUSER's included, as libpq does" do
    env_var_bubble do
      ENV["PGUSER"] = "someone"
      assert parse("postgres://host").database == "someone"
    end
    env_var_bubble do
      ci = parse("postgres://host")
      assert !ci.user.empty?
      assert ci.database == ci.user
    end
  end

  it "reports a parameter it ignores, and not iyi-db's pool options" do
    backend = MemoryBackend.new
    logger = Log.for("pg")
    previous = logger.own_backend
    logger.backend = backend
    parse("postgres://host/db?sslmdoe=verify-full&max_pool_size=2&application_name=x&connect_timeout=5&options=-c%20a%3Db")
    logger.backend = previous
    warnings = backend.entries.select { |e| e.severity >= Severity::Warn }.map(&.message)
    assert warnings == ["Ignoring the connection parameter sslmdoe, which this driver does not support"], warnings.inspect
  end
end

describe "PQ::ConnInfo connect_timeout and options" do
  it "reads connect_timeout as libpq does: 0 or less is none, 1 is 2" do
    env_var_bubble do
      assert parse("postgres://host/db").connect_timeout.nil?
      assert parse("postgres://host/db").connect_timeout_ms.nil?
      assert parse("postgres://host/db?connect_timeout=10").connect_timeout == 10
      assert parse("host=host connect_timeout=10").connect_timeout_ms == 10000
      assert parse("host=host connect_timeout=1").connect_timeout == 2
      assert parse("host=host connect_timeout=0").connect_timeout.nil?
      assert parse("postgres://host/db?connect_timeout=-5").connect_timeout.nil?
      assert ConnInfo.new("host", connect_timeout: 1).connect_timeout == 2
      expect_error(ConnInfo.from_conninfo_string("host=host connect_timeout=soon"), ArgumentError)
      expect_error(ConnInfo.from_conninfo_string("postgres://host/db?connect_timeout=1.5"), ArgumentError)
    end
    nil
  end

  it "reads options, from a URL's query or a quoted value" do
    env_var_bubble do
      assert parse("postgres://host/db").options.nil?
      got = parse("postgres://host/db?options=-c%20search_path%3Dfoo").options
      assert got == "-c search_path=foo", got.inspect
      got = parse("host=host options='-c search_path=foo -c statement_timeout=5000'").options
      assert got == "-c search_path=foo -c statement_timeout=5000", got.inspect
      assert ConnInfo.new("host", options: "-c a=b").options == "-c a=b"
    end
  end
end

describe "PQ::ConnInfo key=value strings" do
  it "reads quoted values, escapes and spaces around = as libpq does" do
    ci = parse("host = host  password='it\\'s a \\\\ secret' application_name='' user=a\\ b")
    assert ci.host == "host", ci.host
    assert ci.password == "it's a \\ secret", ci.password.inspect
    assert ci.application_name == "", ci.application_name
    assert ci.user == "a b", ci.user
    expect_error(ConnInfo.from_conninfo_string("host='host"), ArgumentError)
    expect_error(ConnInfo.from_conninfo_string("host"), ArgumentError)
    expect_error(ConnInfo.from_conninfo_string("host=a port"), ArgumentError)
    nil
  end
end

describe "PQ::ConnInfo environment defaults" do
  it "takes the TLS, connect_timeout and options parameters from PG* variables" do
    env_var_bubble do
      ENV["PGSSLMODE"] = "require"
      ENV["PGSSLROOTCERT"] = "root.crt"
      ENV["PGSSLCERT"] = "client.crt"
      ENV["PGSSLKEY"] = "client.key"
      ENV["PGCHANNELBINDING"] = "disable"
      ENV["PGSSLMINPROTOCOLVERSION"] = "TLSv1.3"
      ENV["PGCONNECT_TIMEOUT"] = "7"
      ENV["PGOPTIONS"] = "-c search_path=foo"
      [parse("postgres://host/db"), parse("host=host")].each do |ci|
        assert ci.sslmode == :require
        assert ci.sslrootcert == "root.crt"
        assert ci.sslcert == "client.crt"
        assert ci.sslkey == "client.key"
        assert ci.channel_binding == :disable
        assert ci.ssl_min_protocol_version == "TLSv1.3"
        assert ci.connect_timeout == 7
        assert ci.options == "-c search_path=foo"
      end
    end
  end

  it "lets the parameters given win over the variables" do
    env_var_bubble do
      ENV["PGSSLMODE"] = "require"
      ENV["PGSSLROOTCERT"] = "root.crt"
      ENV["PGSSLCERT"] = "client.crt"
      ENV["PGSSLKEY"] = "client.key"
      ENV["PGCHANNELBINDING"] = "disable"
      ENV["PGSSLMINPROTOCOLVERSION"] = "TLSv1.3"
      ENV["PGCONNECT_TIMEOUT"] = "7"
      ENV["PGOPTIONS"] = "-c search_path=foo"
      url = parse("postgres://host/db?sslmode=disable&sslrootcert=other.crt&sslcert=o.crt&sslkey=o.key&channel_binding=require&ssl_min_protocol_version=TLSv1.2&connect_timeout=3&options=-c%20x%3Dy")
      pairs = parse("host=host sslmode=disable sslrootcert=other.crt sslcert=o.crt sslkey=o.key channel_binding=require ssl_min_protocol_version=TLSv1.2 connect_timeout=3 options='-c x=y'")
      [url, pairs].each do |ci|
        assert ci.sslmode == :disable
        assert ci.sslrootcert == "other.crt"
        assert ci.sslcert == "o.crt"
        assert ci.sslkey == "o.key"
        assert ci.channel_binding == :require
        assert ci.ssl_min_protocol_version == "TLSv1.2"
        assert ci.connect_timeout == 3
        assert ci.options == "-c x=y"
      end
    end
  end

  it "refuses a variable's value its parameter cannot take, unless the parameter is given" do
    bad = [
      {"PGSSLMODE", "sometimes", "sslmode=require"},
      {"PGCHANNELBINDING", "always", "channel_binding=prefer"},
      {"PGSSLMINPROTOCOLVERSION", "TLSv1.1", "ssl_min_protocol_version=TLSv1.3"},
      {"PGCONNECT_TIMEOUT", "soon", "connect_timeout=4"},
    ]
    bad.each do |entry|
      var, value, param = entry
      env_var_bubble do
        ENV[var] = value
        error = ConnInfo.from_conninfo_string("postgres://host/db")
        assert error.is_a?(ArgumentError), "#{var}=#{value}: #{error.inspect}"
        assert error.message.includes?(var), error.message if error.is_a?(ArgumentError)
        expect_error(ConnInfo.from_conninfo_string("host=host"), ArgumentError)
        parse("postgres://host/db?#{param}")
        parse("host=host #{param}")
      end
    end
    nil
  end

  it "takes PGSSLROOTCERT=system to mean verify-full unless an sslmode is given or PGSSLMODE set" do
    env_var_bubble do
      ENV["PGSSLROOTCERT"] = "system"
      assert parse("postgres://host/db").sslmode == :"verify-full"
      assert parse("host=host").sslmode == :"verify-full"
      assert parse("postgres://host/db?sslmode=require").sslmode == :require
      ENV["PGSSLMODE"] = "require"
      assert parse("postgres://host/db").sslmode == :require
      assert parse("host=host").sslmode == :require
    end
    env_var_bubble do
      ENV["PGSSLMODE"] = "prefer"
      assert parse("postgres://host/db?sslrootcert=system").sslmode == :prefer
    end
  end
end
