# One session of the PostgreSQL frontend/backend protocol, version 3: the
# socket, the startup and authentication, and the messages a statement
# sends and reads. crystal-pg's `PQ::Connection`.
#
# Every read answers its failure: `StreamError` when the socket fails,
# `PQError` when the server answers an `ErrorResponse`, `ConnectionError`
# when the session cannot go on.
module pg/pq/connection

import std/int
import std/time::{Time}
import std/text
import std/file
import std/socket::{IyiSocket, SocketError}
import std/tls::{TlsClient, TlsConfig, TlsError}
import std/slice::{Slice, Bytes}
import db/db/errors::{DBError}
import pg/pq/errors::*
import pg/pq/stream::{Stream}
import pg/pq/conninfo::{ConnInfo}
import pg/pq/frame::*
import pg/pq/param::{Param}
import pg/pq/statement_cache::{StatementCache}
import pg/pq/scram::{SaslContext, md5_password}
import pg/pq/ssl::{tls_config, server_end_point}
import pg/pq/pgpass::{LOG}
# Imported unnamed: its `Frame` is not `pg/pq/frame`'s, so it is written
# out in full below.
import pg/replication/messages

pub class PQConnection
  getter stream : Stream
  getter server_parameters : Hash(String, String)
  getter conninfo : ConnInfo
  property notice_handler : Proc(Notice, Nil)
  property notification_handler : Proc(Notification, Nil)
  @established = false
  # The session's backend process and the key a CancelRequest for it
  # carries, from the server's BackendKeyData; 0 until it sends one.
  @backend_pid = 0
  @secret_key = 0
  # When the attempt that opened this session runs out of `connect_timeout`,
  # on the monotonic clock in milliseconds; nil for no bound.
  @deadline_ms : Int64? = nil
  # The statements this session keeps prepared on the server.
  getter statement_cache : StatementCache
  # The Parse messages this session has sent: one for every statement it
  # prepared, named or unnamed.
  getter parse_count : Int64 = 0_i64
  # The transaction status of the last ReadyForQuery: `'I'` idle, `'T'` in
  # a transaction block, `'E'` in a failed one.
  getter transaction_status : Char = 'I'

  def initialize(@stream : Stream, @conninfo : ConnInfo)
    @server_parameters = {} of String => String
    @notice_handler = ->(notice : Notice) { nil }
    @notification_handler = ->(notification : Notification) { nil }
    @statement_cache = StatementCache.new(@conninfo.statement_cache_capacity)
  end

  # The code an SSLRequest sends where a startup message sends its
  # protocol version.
  SSL_REQUEST_CODE = 80877103

  # The code a CancelRequest sends where a startup message sends its
  # protocol version.
  CANCEL_REQUEST_CODE = 80877102

  # How much sooner than its deadline a wait may end and still be taken
  # for the timeout's: a socket's timer fires on the platform's tick.
  TIMEOUT_SLACK_MS = 50

  # The process id of the session's backend on the server, 0 when the
  # server named none.
  def backend_pid : Int32
    @backend_pid
  end

  # The session *conninfo* describes, started and authenticated, encrypted
  # as its `sslmode` asks: `disable` never; `prefer` when the server takes
  # TLS and its certificate is trusted, unencrypted otherwise; `require`,
  # `verify-ca` and `verify-full` always; `allow` unencrypted, and again
  # over TLS when the server refuses that. A Unix socket is never
  # encrypted, whatever the mode, as libpq has it.
  def self.establish(conninfo : ConnInfo) : PQConnection | DBError
    case conninfo.sslmode
    when :disable
      start(conninfo, :off)
    when :allow
      first = start(conninfo, :off)
      return first unless first.is_a?(PQError) && !conninfo.unix_socket?
      LOG.debug { "The server refused an unencrypted session (#{first.message}): trying TLS" }
      start(conninfo, :must)
    when :prefer
      start(conninfo, :try)
    else
      start(conninfo, :must)
    end
  end

  # Opens and starts a session, *ssl* as `open` takes it.
  private def self.start(conninfo : ConnInfo, ssl : Symbol) : PQConnection | DBError
    pq = open(conninfo, ssl)!
    connected = pq.connect(conninfo.replication)
    if connected.is_a?(DBError)
      timed_out = pq.timed_out?
      pq.close
      return timed_out ? timeout_error(conninfo) : connected
    end
    pq
  end

  # Opens the socket *conninfo* names - a Unix socket in the directory its
  # host names when that is a path, TCP otherwise - and over TCP asks for
  # TLS as *ssl* says: `:off` not at all, `:must` with no session without
  # it, `:try` going on unencrypted when the server declines or the
  # handshake fails. The connect, the TLS handshake, and the startup
  # `connect` makes after, take no longer than `connect_timeout` together.
  def self.open(conninfo : ConnInfo, ssl : Symbol = :off) : PQConnection | DBError
    unix = conninfo.unix_socket?
    # The configuration first: a root or client certificate that cannot be
    # read is the caller's to fix before any server is asked anything.
    config = unix || ssl == :off ? nil : tls_config(conninfo)!

    timeout_ms = conninfo.connect_timeout_ms
    deadline = timeout_ms ? now_ms + timeout_ms : nil
    socket = connect_socket(conninfo, timeout_ms)!
    pq = PQConnection.new(Stream.new(socket), conninfo)
    pq.bound_by(deadline)
    unless pq.arm_timeouts
      socket.close
      return timeout_error(conninfo)
    end
    return pq unless config
    encrypted = pq.request_tls(config)
    return pq if encrypted == true || (encrypted == false && ssl == :try)
    timed_out = pq.timed_out?
    socket.close unless socket.closed?
    return timeout_error(conninfo) if timed_out && encrypted != false
    case encrypted
    when TlsError
      return ConnectionError.new("TLS handshake failed: #{encrypted.message}") if ssl == :must
      LOG.debug { "TLS handshake failed (#{encrypted.message}): connecting unencrypted" }
      open(conninfo, :off)
    when DBError
      encrypted
    else
      ConnectionError.new("the server does not support TLS, but sslmode=#{conninfo.sslmode} requires it")
    end
  end

  # The socket *conninfo* names - a Unix socket in the directory its host
  # names when that is a path, TCP otherwise - connected within
  # *timeout_ms* when it is given. The bound is kept by cancelling the
  # connect as well as by handing it to std/socket, which on Windows
  # waits as long as the kernel does (`ConnectEx`: 21 s measured to an
  # address that drops the handshake; iyilang/iyi#131).
  protected def self.connect_socket(conninfo : ConnInfo, timeout_ms : Int32?) : IyiSocket | DBError
    fired = false
    socket = if conninfo.unix_socket?
               IyiSocket.connect_unix(File.join(conninfo.host, ".s.PGSQL.#{conninfo.port}"))
             elsif ms = timeout_ms
               host = conninfo.host
               port = conninfo.port
               got = nil.as(IyiSocket | Cancelled | SocketError | Nil)
               group do |g|
                 connecting = g.spawn { IyiSocket.connect(host, port, ms) }
                 g.spawn do
                   unless sleep(ms).is_a?(Cancelled)
                     fired = true
                     g.cancel_children
                   end
                   0
                 end
                 got = connecting.value
                 g.cancel_children
               end
               got
             else
               IyiSocket.connect(conninfo.host, conninfo.port)
             end
    case socket
    when IyiSocket
      socket
    when SocketError
      return timeout_error(conninfo) if timeout_ms && socket.timed_out?
      ConnectionError.new("Cannot establish connection: #{socket.reason}")
    else
      fired ? timeout_error(conninfo) : ConnectionError.new("Cannot establish connection: cancelled")
    end
  end

  # The monotonic clock in milliseconds.
  protected def self.now_ms : Int64
    (Time.monotonic_nanoseconds // 1000000_u64).to_i64
  end

  # What an attempt that ran out of `connect_timeout` answers.
  protected def self.timeout_error(conninfo : ConnInfo) : ConnectionError
    where = conninfo.unix_socket? ? File.join(conninfo.host, ".s.PGSQL.#{conninfo.port}") : IyiSocket.endpoint(conninfo.host, conninfo.port)
    ConnectionError.new("Cannot establish connection: timeout expired after #{conninfo.connect_timeout} s (connect_timeout) connecting to #{where}")
  end

  # The attempt opening this session ends at *deadline_ms*, nil for never.
  protected def bound_by(deadline_ms : Int64?) : Nil
    @deadline_ms = deadline_ms
  end

  # The milliseconds left of the attempt's `connect_timeout`, nil when it
  # has none.
  protected def remaining_ms : Int64?
    if deadline = @deadline_ms
      deadline - PQConnection.now_ms
    end
  end

  # Bounds the socket's reads and writes by what is left of the attempt:
  # false when nothing is. What is left is never more than
  # `connect_timeout_ms`, an `Int32`.
  protected def arm_timeouts : Bool
    left = remaining_ms
    return true if left.nil?
    return false if left <= 0
    @stream.socket.read_timeout_ms = left.to_i32
    @stream.socket.write_timeout_ms = left.to_i32
    true
  end

  # Whether the attempt opening this session ran out of time.
  protected def timed_out? : Bool
    left = remaining_ms
    !left.nil? && left <= TIMEOUT_SLACK_MS
  end

  # Asks the server for TLS (an SSLRequest) and, when it agrees, makes the
  # session's handshake under *config*, checking its certificate for the
  # host connected to: true once encrypted, false when the server declines,
  # the `TlsError` of a failed handshake, or the server's error; on any of
  # those but false the socket is the caller's to close.
  def request_tls(config : TlsConfig) : Bool | TlsError | DBError
    @stream.write_i32(8)
    @stream.write_i32(SSL_REQUEST_CODE)
    @stream.flush!
    case answer = @stream.read_char!
    when 'S'
      if @stream.buffered?
        return ConnectionError.new("the server sent unencrypted data after agreeing to TLS")
      end
      tls = if left = remaining_ms
              TlsClient.over(@stream.socket, @conninfo.host, config, left < 1 ? 1 : left.to_i32)
            else
              TlsClient.over(@stream.socket, @conninfo.host, config)
            end
      return tls if tls.is_a?(TlsError)
      @stream.start_tls(tls)
      true
    when 'N'
      false
    when 'E'
      # The server failed before it could answer (it could not start a
      # backend, say): its ErrorResponse follows.
      error = read('E')
      error.is_a?(DBError) ? error : ConnectionError.new("the server answered the SSLRequest with #{error}")
    else
      ConnectionError.new("the server answered the SSLRequest with #{answer.inspect}")
    end
  end

  def soc : Stream
    @stream
  end

  def closed? : Bool
    @stream.closed?
  end

  def close : Nil
    return if @stream.closed?
    send_terminate_message
    @stream.flush
    @stream.close
  end

  # ------------------------------------------------------------ reading

  def read_i32 : Int32 | DBError
    @stream.read_i32
  end

  def read_i16 : Int16 | DBError
    @stream.read_i16
  end

  def read_bytes(count : Int32) : Bytes | DBError
    @stream.read_bytes(count)
  end

  def read_direct(target : Pointer(UInt8), count : Int32) : Int32 | DBError
    @stream.read_some(target, count)
  end

  def skip_bytes(count : Int32) : Nil | DBError
    @stream.skip(count)
  end

  # The next message, past the ones a session handles on its own: notices,
  # notifications and parameter changes. An `ErrorResponse` is answered as
  # a `PQError`.
  def read : Frame | DBError
    read(@stream.read_char!)
  end

  def read(frame_type : Char) : Frame | DBError
    type = frame_type
    while true
      frame = read_one_frame(type)!
      handled = handle_async_frames(frame)!
      return frame unless handled
      type = @stream.read_char!
    end
  end

  # Reads messages until the socket is closed, handing notices and
  # notifications to their handlers: the loop of a `LISTEN`ing connection.
  def read_async_frame_loop : Nil | DBError
    while true
      break if @stream.closed?
      type = @stream.read_char
      if type.is_a?(DBError)
        break if @stream.closed?
        return type
      end
      frame = read_one_frame(type)
      if frame.is_a?(DBError)
        break if @stream.closed?
        return frame
      end
      handled = handle_async_frames(frame)
      return handled if handled.is_a?(DBError)
    end
    nil
  end

  private def read_one_frame(frame_type : Char) : Frame | DBError
    size = @stream.read_i32!
    return StreamError.new("Malformed #{frame_type.inspect} message: a length of #{size}") if size < 4
    slice = @stream.read_bytes(size - 4)!
    frame = Frame.new(frame_type, slice)
    return StreamError.new("Malformed #{frame_type.inspect} message: its body ends early") if frame.short?
    frame
  end

  # `true` when *frame* was handled here and the caller reads the next one.
  # A ReadyForQuery's transaction status is noted, and a command that
  # dropped the session's prepared statements, or changed the schema,
  # empties its cache; both are still the caller's to read.
  private def handle_async_frames(frame : Frame) : Bool | DBError
    case frame
    when Frame::ErrorResponse
      expect_frame(Frame::ReadyForQuery)! if @established
      @notice_handler.call(frame.as_notice)
      PQError.new(frame.fields)
    when Frame::NotificationResponse
      @notification_handler.call(frame.as_notification)
      true
    when Frame::NoticeResponse
      @notice_handler.call(frame.as_notice)
      true
    when Frame::ParameterStatus
      @server_parameters[frame.key] = frame.value
      case frame.key
      when "client_encoding"
        if frame.value.upcase != "UTF8"
          return ConnectionError.new(
            "Only UTF8 is supported for client_encoding, got: #{frame.value.inspect}")
        end
      when "integer_datetimes"
        if frame.value != "on"
          return ConnectionError.new(
            "Only on is supported for integer_datetimes, got: #{frame.value.inspect}")
        end
      else
        # nothing to check
      end
      true
    when Frame::ReadyForQuery
      @transaction_status = frame.transaction_status
      false
    when Frame::CommandComplete
      if frame.drops_statements?
        @statement_cache.forget_all
      elsif frame.changes_schema?
        # A statement prepared before keeps the parameter types inferred
        # then, and a value converts to an old one without an error: a
        # `Time` bound to a `timestamp` parameter of a table recreated
        # with a `timestamptz` column lost its zone. Prepared anew, the
        # types are the new schema's. DDL from another session is not
        # seen here; see the README.
        @statement_cache.evict_all
      end
      false
    else
      false
    end
  end

  # The next message, which must be a *frame_class*; a type already read
  # is passed as *type*.
  def expect_frame(frame_class : T.class, type : Char? = nil) : T | DBError forall T
    f = type ? read(type)! : read!
    return f.as(T) if f.is_a?(T)
    DBError.new("Expected #{frame_class} but got #{f}")
  end

  # Whether a `DataRow` follows; at the end of the rows the
  # `CommandComplete` is read.
  def read_next_row_start : Bool | DBError
    type = @stream.read_char!

    while type == 'N'
      # NoticeResponse
      frame = read_one_frame('N')!
      handle_async_frames(frame)!
      type = @stream.read_char!
    end

    if type == 'D'
      true
    else
      expect_frame(Frame::CommandComplete, type)!
      false
    end
  end

  # Reads one `DataRow`, its type byte already read, and yields its columns:
  # each one's bytes, nil for NULL.
  def read_data_row(& : Array(Bytes?) -> Nil) : Nil | DBError
    @stream.read_i32! # size
    ncols = @stream.read_i16!
    row = [] of Bytes?
    ncols.to_i32.times do
      col_size = @stream.read_i32
      return col_size if col_size.is_a?(DBError)
      if col_size == -1
        row << nil
      else
        bytes = @stream.read_bytes(col_size)
        return bytes if bytes.is_a?(DBError)
        row << bytes
      end
    end
    yield row
    nil
  end

  # Reads every `DataRow` and the `CommandComplete` after them, yielding each
  # row as `read_data_row` does.
  def read_all_data_rows(& : Array(Bytes?) -> Nil) : Nil | DBError
    type = @stream.read_char!
    while type == 'D'
      read_data_row { |row| yield row }!
      type = @stream.read_char!
    end
    expect_frame(Frame::CommandComplete, type)!
    nil
  end

  # Whether a `CopyData` follows; at the end of the data the `CopyDone` is
  # read.
  def read_next_copy_start : Bool | DBError
    type = @stream.read_char!

    while type == 'N'
      # NoticeResponse
      frame = read_one_frame('N')!
      handle_async_frames(frame)!
      type = @stream.read_char!
    end

    if type == 'd'
      true
    else
      expect_frame(Frame::CopyDone, type)!
      false
    end
  end

  # ------------------------------------------------------------ startup

  def startup(args : Array(String)) : Nil | DBError
    len = args.reduce(0) { |acc, arg| acc + arg.bytesize + 1 }
    @stream.write_i32(len + 8 + 1)
    @stream.write_i32(0x30000)
    args.each do |arg|
      @stream.write(arg)
      @stream.write_byte(0_u8)
    end
    @stream.write_byte(0_u8)
    @stream.flush
  end

  # Starts the session: startup, authentication, and the parameters the
  # server reports until it is ready for a query, within what is left of
  # `connect_timeout`.
  def connect(replication : String? = nil) : Nil | DBError
    return PQConnection.timeout_error(@conninfo) unless arm_timeouts
    startup_args = [
      "user", @conninfo.user,
      "database", @conninfo.database,
      "application_name", @conninfo.application_name,
      "client_encoding", "utf8",
    ]
    if options = @conninfo.options
      startup_args << "options"
      startup_args << options
    end
    if replication
      startup_args << "replication"
      startup_args << replication
    end

    startup(startup_args)!

    auth_frame = expect_frame(Frame::Authentication)!
    handle_auth(auth_frame)!

    while true
      frame = read!
      case frame
      when Frame::BackendKeyData
        @backend_pid = frame.pid
        @secret_key = frame.secret
      when Frame::ReadyForQuery
        break
      else
        return DBError.new("Expected BackendKeyData or ReadyForQuery but was #{frame}")
      end
    end

    unless @deadline_ms.nil?
      @stream.socket.read_timeout_ms = nil
      @stream.socket.write_timeout_ms = nil
    end
    @established = true
    nil
  end

  # Asks the server to cancel what this session is running, from any task,
  # the session busy or not: a CancelRequest naming its backend, sent on a
  # new connection to the same host and port (or Unix socket), which the
  # server closes once it has the request. The request is sent unencrypted
  # whatever the `sslmode`, as libpq before 17 sends it. What was running
  # then fails with SQLSTATE 57014 (query_canceled); if nothing was, the
  # request does nothing. `connect_timeout` bounds the exchange.
  def cancel : Nil | DBError
    if @backend_pid == 0
      return ConnectionError.new("Cannot cancel: the server sent no BackendKeyData for this session")
    end
    timeout_ms = @conninfo.connect_timeout_ms
    socket = PQConnection.connect_socket(@conninfo, timeout_ms)!
    socket.read_timeout_ms = timeout_ms
    socket.write_timeout_ms = timeout_ms
    stream = Stream.new(socket)
    stream.write_i32(16)
    stream.write_i32(CANCEL_REQUEST_CODE)
    stream.write_i32(@backend_pid)
    stream.write_i32(@secret_key)
    sent = stream.flush
    # The server answers nothing and closes the connection when it has the
    # request: the end of the stream is that.
    stream.read_byte unless sent.is_a?(DBError)
    stream.close
    sent.is_a?(DBError) ? ConnectionError.new("Cannot send the cancel request: #{sent.message}") : nil
  end

  private def handle_auth(auth_frame : Frame::Authentication) : Nil | DBError
    if @conninfo.channel_binding == :require && auth_frame.type != Frame::Authentication::Type::SASL.value
      # Nothing is sent to a server that has not proven it holds the
      # channel, and no session it grants is taken.
      how = auth_frame.type == Frame::Authentication::Type::OK.value ? "without a password exchange" : "with #{auth_type_name(auth_frame.type)}"
      return ConnectionError.new(
        "channel_binding=require, but the server would let the client in #{how}, which binds no channel"
      )
    end
    case auth_frame.type
    when Frame::Authentication::Type::OK.value
      # no op
    when Frame::Authentication::Type::CleartextPassword.value
      check_auth_method("cleartext")!
      send_password_message(@conninfo.password)!
      expect_frame(Frame::Authentication)!
    when Frame::Authentication::Type::SASL.value
      # the method is checked in the sasl handler
      handle_auth_sasl(auth_frame.body_string)!
    when Frame::Authentication::Type::MD5Password.value
      check_auth_method("md5")!
      salt = auth_frame.body_string
      send_password_message(md5_password(@conninfo.user, @conninfo.password || "", salt))!
      expect_frame(Frame::Authentication)!
    else
      return ConnectionError.new(
        "unsupported authentication method: #{auth_type_name(auth_frame.type)}"
      )
    end
    nil
  end

  private def auth_type_name(type : Int32) : String
    found = Frame::Authentication::Type.from_value?(type)
    found.nil? ? type.to_s : found.to_s
  end

  private def check_auth_method(method : String) : Nil | ConnectionError
    unless @conninfo.auth_methods.includes?(method)
      return ConnectionError.new(
        "server asked for disabled authentication method: #{method}"
      )
    end
    nil
  end

  # The server's `tls-server-end-point` binding, when the session is
  # encrypted, `channel_binding` allows it, and the certificate's signature
  # names a hash; nil otherwise, with why.
  private def channel_binding_data : Array(UInt8) | String
    return "channel_binding=disable" if @conninfo.channel_binding == :disable
    tls = @stream.tls
    return "the connection is not encrypted" if tls.nil?
    certificate = tls.peer_certificates.first?
    return "the server sent no certificate" if certificate.nil?
    server_end_point(certificate) ||
      "the server's certificate is signed under #{certificate.signature_algorithm}, whose hash tls-server-end-point does not name"
  end

  # SCRAM-SHA-256-PLUS when the server offers it and the channel can be
  # bound (see `channel_binding_data`), SCRAM-SHA-256 otherwise, unless
  # `channel_binding=require`.
  private def handle_auth_sasl(mechanism_list : String) : Nil | DBError
    mechs = mechanism_list.split('\0').reject(&.empty?)
    binding = channel_binding_data
    plus_offered = mechs.includes?(SaslContext::SCRAM_PLUS_NAME)
    password = @conninfo.password || ""
    ctx = if binding.is_a?(Array(UInt8)) && plus_offered && @conninfo.auth_methods.includes?("scram-sha-256-plus")
            SaslContext.new(password, binding: binding)
          else
            if @conninfo.channel_binding == :require
              why = if binding.is_a?(String)
                      binding
                    elsif !plus_offered
                      "the server did not offer SCRAM-SHA-256-PLUS"
                    else
                      "auth_methods does not name scram-sha-256-plus"
                    end
              return ConnectionError.new("channel_binding=require, but the channel cannot be bound: #{why}")
            end
            unless mechs.includes?(SaslContext::SCRAM_NAME)
              if plus_offered
                return ConnectionError.new("the server offered only SCRAM-SHA-256-PLUS, and the channel cannot be bound: #{binding.is_a?(String) ? binding : "auth_methods does not name scram-sha-256-plus"}")
              end
              return ConnectionError.new("no known sasl mechanism in list: #{mechs.join(", ")}")
            end
            check_auth_method("scram-sha-256")!
            # "y": this side could bind the channel, the server offered no
            # way to - which the server refuses if it did offer one that a
            # man in the middle took out of the list.
            SaslContext.new(password, binding_possible: binding.is_a?(Array(UInt8)) && !plus_offered)
          end

    # send client-first-message
    @stream.write_char('p') # SASLInitialResponse
    @stream.write_i32(4 + ctx.name.bytesize + 1 + 4 + ctx.client_first_msg.bytesize)
    @stream.write(ctx.name)
    @stream.write_byte(0_u8)
    @stream.write_i32(ctx.client_first_msg.bytesize)
    @stream.write(ctx.client_first_msg)
    @stream.flush!

    # receive server-first-message
    continue = expect_frame(Frame::Authentication)!
    final_msg = ctx.generate_client_final_message(continue.body_string)!

    # send client-final-message
    @stream.write_char('p')
    @stream.write_i32(4 + final_msg.bytesize)
    @stream.write(final_msg)
    @stream.flush!

    # receive server-final-message
    final = expect_frame(Frame::Authentication)!
    ctx.verify_server_signature(final.body_string)!
    # receive OK
    expect_frame(Frame::Authentication)!
    nil
  end

  # ------------------------------------------------------------ queries

  # Runs *query* with the simple query protocol: any number of statements,
  # their rows ignored.
  def simple_query(query : String) : Nil | DBError
    send_query_message(query)!
    while true
      frame = read!
      break if frame.is_a?(Frame::ReadyForQuery)
    end
    nil
  end

  def send_password_message(password : String?) : Nil | DBError
    @stream.write_char('p')
    if password
      @stream.write_i32(password.bytesize + 4 + 1)
      @stream.write(password)
    else
      @stream.write_i32(4 + 1)
    end
    @stream.write_byte(0_u8)
    @stream.flush
  end

  def send_query_message(query : String) : Nil | DBError
    @stream.write_char('Q')
    @stream.write_i32(query.bytesize + 4 + 1)
    @stream.write(query)
    @stream.write_byte(0_u8)
    @stream.flush
  end

  # Parses *query* into the prepared statement *name*, the unnamed one when
  # it is empty, leaving the parameters' types to the server.
  def send_parse_message(query : String, name : String = "") : Nil
    @parse_count += 1
    @stream.write_char('P')
    @stream.write_i32(4 + name.bytesize + 1 + query.bytesize + 1 + 2)
    @stream.write(name)
    @stream.write_byte(0_u8)
    @stream.write(query)
    @stream.write_byte(0_u8)
    @stream.write_i16(0) # don't give any param types
  end

  # Binds *params* to the prepared statement *statement* (the unnamed one
  # when it is empty) in the unnamed portal. *result_format* 1 asks for
  # binary results, which every decoder reads; 0 asks for text.
  def send_bind_message(params : Array(Param), statement : String = "", result_format : Int32 = 1) : Nil
    nparams = params.size
    total_size = params.reduce(0) do |acc, p|
      acc + 4 + (p.size == -1 ? 0 : p.size)
    end

    @stream.write_char('B')
    @stream.write_i32(4 + 1 + statement.bytesize + 1 + 2 + (2 * nparams) + 2 + total_size + 2 + 2)
    @stream.write_byte(0_u8) # unnamed destination portal
    @stream.write(statement)
    @stream.write_byte(0_u8)
    @stream.write_i16(nparams) # number of params format codes to follow
    params.each { |p| @stream.write_i16(p.format.to_i32) }
    @stream.write_i16(nparams) # number of params to follow
    params.each do |p|
      @stream.write_i32(p.size)
      @stream.write(p.slice) if p.size > 0
    end
    @stream.write_i16(1) # number of following return types (1 means apply next for all)
    @stream.write_i16(result_format)
  end

  def send_describe_portal_message : Nil
    @stream.write_char('D')
    @stream.write_i32(4 + 1 + 1)
    @stream.write_char('P')
    @stream.write_byte(0_u8)
  end

  # Asks for the prepared statement *name*'s parameter types and the
  # description of its rows: a ParameterDescription, then a RowDescription
  # or NoData.
  def send_describe_statement_message(name : String) : Nil
    @stream.write_char('D')
    @stream.write_i32(4 + 1 + name.bytesize + 1)
    @stream.write_char('S')
    @stream.write(name)
    @stream.write_byte(0_u8)
  end

  # Closes the prepared statement *name*: a CloseComplete, even when the
  # session has no statement by that name.
  def send_close_statement_message(name : String) : Nil
    @stream.write_char('C')
    @stream.write_i32(4 + 1 + name.bytesize + 1)
    @stream.write_char('S')
    @stream.write(name)
    @stream.write_byte(0_u8)
  end

  def send_execute_message : Nil
    @stream.write_char('E')
    @stream.write_i32(4 + 1 + 4)
    @stream.write_byte(0_u8) # unnamed portal
    @stream.write_i32(0)     # unlimited maximum rows
  end

  def send_sync_message : Nil | DBError
    @stream.write_char('S')
    @stream.write_i32(4)
    @stream.flush
  end

  def send_terminate_message : Nil
    @stream.write_char('X')
    @stream.write_i32(4)
  end

  # One CopyData message; once a buffer's worth is waiting, it is sent, so a
  # COPY FROM STDIN streams rather than collecting its whole input.
  def send_copy_data_message(slice : Bytes) : Nil | DBError
    @stream.write_char('d')
    @stream.write_i32(4 + slice.size)
    @stream.write(slice)
    @stream.flush! if @stream.pending >= Stream::BUFFER_SIZE
    nil
  end

  def send_copy_done_message : Nil | DBError
    @stream.write_char('c')
    @stream.write_i32(4)
    @stream.flush
  end

  # Starts logical replication from *slot_name* at *start_lsn*, for the
  # publication *publication_name*, and hands every frame the server
  # streams to *block* until the socket is closed. A frame that cannot be
  # parsed is logged and skipped, as crystal-pg did; a socket that fails
  # while still open is answered as its `StreamError`.
  def start_replication_frame_loop(publication_name : String, slot_name : String, start_lsn : Int64 = 0_i64, &block : ::Pg::Replication::Messages::Frame -> Nil) : Nil | DBError
    lsn = "#{(start_lsn >> 32).to_s(16).upcase}/#{(start_lsn & 0xFFFF_FFFF_i64).to_s(16).upcase}"
    command = "START_REPLICATION SLOT #{slot_name} LOGICAL #{lsn} (proto_version '1', binary 'true', publication_names '#{publication_name}')"
    send_query_message(command)!
    while true
      break if @stream.closed?
      frame = ::Pg::Replication::Messages::Frame.from_io(@stream)
      case frame
      when StreamError
        break if @stream.closed?
        return frame
      when DBError
        reason = frame.message
        LOG.error { "Replication frame: #{reason}" }
      else
        block.call(frame)
      end
    end
    nil
  end
end
