# The data of a `COPY ... TO STDOUT`, or the sink of a `COPY ... FROM
# STDIN`: what `PGConnection#exec_copy` answers.
module pg/copy_result

import std/int
import std/slice::{Slice, Bytes}
import db/db/errors::{DBError}
import pg/pq/frame::*
import pg/pq/connection::{PQConnection}

# crystal-pg's `PG::CopyResult` is an `IO`; iyi's `IyiIO` cannot answer an
# error, so this has the reading and writing methods a copy needs, each
# answering its failure.
pub class CopyResult
  @reading : Bool
  @frame_size = 0
  @end = false
  @closed = false

  # Sends *query* and reads the response that starts the copy.
  def self.open(connection : PQConnection, query : String) : CopyResult | DBError
    connection.send_query_message(query)!
    response = connection.read!
    case response
    when Frame::CopyOutResponse
      CopyResult.new(connection, true)
    when Frame::CopyInResponse
      CopyResult.new(connection, false)
    else
      DBError.new("Expected CopyOutResponse or CopyInResponse but got #{response}")
    end
  end

  def initialize(@connection : PQConnection, @reading : Bool)
  end

  def closed? : Bool
    @closed
  end

  private def read_final(done : Bool) : Nil | DBError
    return nil if @end
    @end = true

    unless done
      @connection.skip_bytes(@frame_size)! if @frame_size > 0

      while @connection.read_next_copy_start!
        size = @connection.read_i32! - 4
        @connection.skip_bytes(size)!
      end
    end

    @connection.expect_frame(Frame::CommandComplete)!
    @connection.expect_frame(Frame::ReadyForQuery)!
    nil
  end

  # Returns the number of remaining bytes in the current row.
  # Returns 0 the are no more rows to be read.
  # This can be used to allocate the precise amount of memory to read a complete row.
  #
  # ```
  # size = io.remaining_row_size!
  # if size != 0
  #   row = Bytes.new(size)
  #   io.read(row)!
  #   # Process the row.
  # end
  # ```
  def remaining_row_size : Int32 | DBError
    return DBError.new("Can't read from a write-only PG::CopyResult") unless @reading
    return DBError.new("Closed stream") if @closed

    return 0 if @end

    if @frame_size == 0
      if @connection.read_next_copy_start!
        @frame_size = @connection.read_i32! - 4
      else
        read_final(true)!
        return 0
      end
    end

    @frame_size
  end

  # Reads at most `slice.size` bytes of the current row into *slice*; 0 at
  # the end of the data.
  def read(slice : Bytes) : Int32 | DBError
    return 0 if slice.empty?

    remaining = remaining_row_size!
    return 0 if remaining == 0

    max_bytes = slice.size > remaining ? remaining : slice.size
    bytes = @connection.read_direct(slice.to_unsafe, max_bytes)!
    @frame_size -= bytes
    bytes
  end

  # The next byte, or nil at the end of the data.
  def read_byte : UInt8 | Nil | DBError
    byte = Bytes.new(1)
    read(byte)! == 0 ? nil : byte[0]
  end

  # The next character, or nil at the end of the data. COPY's text format
  # is UTF-8, and a character here is one byte of it.
  def read_char : Char | Nil | DBError
    byte = read_byte!
    byte.nil? ? nil : byte.unsafe_chr
  end

  # Everything left of the data.
  def gets_to_end : String | DBError
    String.build do |io|
      buffer = Bytes.new(4096)
      while true
        n = read(buffer)
        return n if n.is_a?(DBError)
        break if n == 0
        io.write(buffer.to_unsafe, n)
      end
    end
  end

  def write(slice : Bytes) : Nil | DBError
    return DBError.new("Can't write to a read-only PG::CopyResult") if @reading
    @connection.send_copy_data_message(slice)
    nil
  end

  def write(text : String) : Nil | DBError
    write(Bytes.new(text.to_unsafe, text.bytesize, read_only: true))
  end

  def <<(text : String) : Nil | DBError
    write(text)
  end

  # Ends the copy: the data not read is skipped, the data written is sent.
  def close : Nil | DBError
    return nil if @closed
    if @reading
      read_final(false)!
    else
      @connection.send_copy_done_message!
      @connection.expect_frame(Frame::CommandComplete)!
      @connection.expect_frame(Frame::ReadyForQuery)!
    end
    @closed = true
    nil
  end
end
