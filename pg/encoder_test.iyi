# crystal-pg's spec/pg/encoder_spec.cr.
module pg/encoder_test

import std/int
import std/float
import std/time::{Time}
import db/db/errors::*
import db/db/value::{DBValue, CustomValue}
import db/db/spec::{describe, it}
import pg/interval::{Interval}
import pg/geo::{Point, Line, Circle, LineSegment, Box, Path, Polygon}
import pg/testing/spec_helper::*

enum Status
  Open
  Closed
end

# Inserts *value* into a column of *datatype* as a bound argument, then
# reads it back as its own type.
def test_insert_and_read(datatype : String, value : T) : Nil forall T
  it "inserts #{datatype}" do
    PG_DB.exec("drop table if exists test_table").or_panic
    PG_DB.exec("create table test_table (v #{datatype})").or_panic
    PG_DB.exec("insert into test_table values ($1)", args: [value]).or_panic

    # Read casting the value
    actual_value = PG_DB.query_one("select v from test_table", as: T).or_panic
    assert actual_value == value, "#{datatype}: expected #{value.inspect}, got #{actual_value.inspect}"
  end
end

describe "PG::Driver encoder" do
  test_insert_and_read "int4", 123

  test_insert_and_read "float", 12.34

  test_insert_and_read "varchar", "hello world"

  test_insert_and_read "timestamp", Time.utc(2015, 2, 3, 17, 15, nanosecond: 13_000_000)
  test_insert_and_read "timestamp", Time.utc(2015, 2, 3, 17, 15, 13, nanosecond: 11_000_000)
  test_insert_and_read "timestamp", Time.utc(2015, 2, 3, 17, 15, 13, nanosecond: 123_456_000)
  # iyi's `Time` is UTC only: 12:30 at the fixed offset -04:00 is 16:30 UTC
  test_insert_and_read "timestamptz", Time.utc(2019, 8, 13, 16, 30)

  # An enum is not a `DBValue`: its `value` is bound and read back
  test_insert_and_read "int4", Status::Open.value
  test_insert_and_read "int4", Status::Closed.value

  test_insert_and_read "bool[]", [true, false, true]

  test_insert_and_read "float[]", [1.2, 3.4, 5.6]

  test_insert_and_read "integer[]", [] of Int32
  test_insert_and_read "integer[]", [1, 2, 3]
  test_insert_and_read "integer[]", [[1, 2], [3, 4]]

  test_insert_and_read "text[]", ["t", "f", "t"]
  test_insert_and_read "text[]", [%("a), %(\\b~), %(c\\"d), "\uFF8F"]
  test_insert_and_read "text[]", ["baz, bar"]
  test_insert_and_read "text[]", ["foo}"]

  test_insert_and_read "interval", Interval.new
  test_insert_and_read "interval", Interval.new(days: 400, microseconds: 5000000_i64)

  describe "geo" do
    test_insert_and_read "point", Point.new(1.2, 3.4)
    if db_version_gte(9, 4)
      test_insert_and_read "line", Line.new(1.2, 3.4, 5.6)
    end
    test_insert_and_read "circle", Circle.new(1.2, 3.4, 5.6)
    test_insert_and_read "lseg", LineSegment.new(1.2, 3.4, 5.6, 7.8)
    test_insert_and_read "box", Box.new(1.2, 3.4, 5.6, 7.8)
    test_insert_and_read "path", Path.new([
      Point.new(1.2, 3.4),
      Point.new(5.6, 7.8),
    ], closed: false)
    test_insert_and_read "path", Path.new([
      Point.new(1.2, 3.4),
      Point.new(5.6, 7.8),
    ], closed: true)
    test_insert_and_read "polygon", Polygon.new([
      Point.new(1.2, 3.4),
      Point.new(5.6, 7.8),
    ])
  end
end
